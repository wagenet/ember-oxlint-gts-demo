{
  "plugins": ["eslint", "typescript", "oxc", "import", "promise", "unicorn"],
  "jsPlugins": ["eslint-plugin-ember"],
  "categories": {
    "correctness": "error"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/no-unnecessary-condition": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-floating-promises": "error",
    "ember/template-no-let-reference": "error",
    "ember/no-empty-glimmer-component-classes": "error",
    "ember/require-return-from-computed": "error"
  },
  "overrides": [
    {
      "files": ["**/*.{gjs,gts}"],
      "languageOptions": {
        "parser": "ember-eslint-parser"
      },
      "rules": {
        "ember/require-return-from-computed": "off"
      }
    }
  ],
  "ignorePatterns": ["/dist", "/coverage", "/declarations", "/.oxlint-internal"]
}
